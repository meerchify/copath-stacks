# Storefront branding (safe defaults — change to your store name)
COMPANY_NAME="Universal Store"
SITE_NAME="Universal Store"

# Shopify Storefront API — connect your store to load products & checkout.
# In Codrafts: open App Details → Publish → Environment variables and add these
# (target "Development" or "All"). The dev server restarts automatically.
#   SHOPIFY_STORE_DOMAIN              your-store.myshopify.com
#   SHOPIFY_STOREFRONT_ACCESS_TOKEN  Storefront API access token
# Until they're set the store boots in "demo" mode (no products) — that's expected.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Optional: secret for the /api/revalidate webhook (on-demand ISR from Shopify).
SHOPIFY_REVALIDATION_SECRET=""
