<footer class="ftr-min">
  <div class="page-width ftr-min__inner">
    <a class="ftr-min__logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
    <nav class="ftr-min__links" aria-label="Footer">
      {%- for link in section.settings.menu.links -%}
        <a class="ftr-min__link" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <span class="ftr-min__copyright">&copy; {{ 'now' | date: '%Y' }}</span>
  </div>
</footer>

{% stylesheet %}
  .ftr-min { border-top: 1px solid var(--color-border); margin-top: clamp(40px, 7vw, 96px); }
  .ftr-min__inner { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding-block: clamp(32px, 4vw, 56px); text-align: center; }
  .ftr-min__logo { font-family: var(--font-heading--family, var(--font-primary--family)); font-weight: 700; font-size: 1.3rem; text-decoration: none; color: var(--color-foreground); }
  .ftr-min__links { display: flex; gap: 1.4rem; flex-wrap: wrap; justify-content: center; }
  .ftr-min__link { text-decoration: none; color: var(--color-foreground); font-size: 0.9rem; opacity: 0.8; }
  .ftr-min__link:hover { opacity: 1; }
  .ftr-min__copyright { font-size: 0.8rem; opacity: 0.6; }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer — Minimal",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
  ]
}
{% endschema %}
