<footer class="ftr-nl">
  <div class="page-width">
    <div class="ftr-nl__cta">
      <div class="ftr-nl__cta-text">
        {%- if section.settings.heading != blank -%}<h2 class="ftr-nl__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="ftr-nl__sub">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- form 'customer', class: 'ftr-nl__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input class="ftr-nl__input" type="email" name="contact[email]" placeholder="Email address" required aria-label="Email">
        <button class="btn btn--primary" type="submit">{{ section.settings.button_label | default: 'Subscribe' }}</button>
        {%- if form.posted_successfully? -%}<p class="ftr-nl__ok">Thanks for subscribing!</p>{%- endif -%}
      {%- endform -%}
    </div>

    <div class="ftr-nl__bottom">
      <a class="ftr-nl__logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
      <nav class="ftr-nl__links" aria-label="Footer">
        {%- for link in section.settings.menu.links -%}
          <a class="ftr-nl__link" href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
      <span class="ftr-nl__copyright">&copy; {{ 'now' | date: '%Y' }}</span>
    </div>
  </div>
</footer>

{% stylesheet %}
  .ftr-nl { border-top: 1px solid var(--color-border); margin-top: clamp(40px, 7vw, 96px); }
  .ftr-nl__cta { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 64px); align-items: center; padding-block: clamp(40px, 5vw, 72px); }
  .ftr-nl__heading { font-family: var(--font-heading--family, var(--font-primary--family)); font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1.05; letter-spacing: -0.02em; }
  .ftr-nl__sub { opacity: 0.75; margin-top: 0.6rem; }
  .ftr-nl__form { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .ftr-nl__input { flex: 1 1 220px; padding: 0.85rem 1rem; border: 1px solid var(--color-border); border-radius: var(--style-border-radius-inputs, 6px); background: var(--color-background); color: var(--color-foreground); }
  .ftr-nl__ok { flex-basis: 100%; color: var(--color-accent); font-size: 0.85rem; }
  .ftr-nl__bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--color-border); padding-block: 1.5rem; flex-wrap: wrap; }
  .ftr-nl__logo { font-family: var(--font-heading--family, var(--font-primary--family)); font-weight: 700; font-size: 1.2rem; text-decoration: none; color: var(--color-foreground); }
  .ftr-nl__links { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .ftr-nl__link { text-decoration: none; color: var(--color-foreground); font-size: 0.88rem; opacity: 0.8; }
  .ftr-nl__link:hover { opacity: 1; }
  .ftr-nl__copyright { font-size: 0.8rem; opacity: 0.6; }
  @media (max-width: 800px) { .ftr-nl__cta { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer — Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the list for new drops and members-only deals." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Subscribe" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
  ]
}
{% endschema %}
