{% comment %}
  Product gallery — main image + thumbnail strip. Thumb clicks swap the main
  image (wired by the product-main section's JS via .pgal__main img / [data-thumb]).
  Usage: {% render 'product-gallery' %}  (relies on the global `product`).
{% endcomment %}
<div class="pgal" data-gallery>
  <div class="pgal__main">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', class: 'pgal__img', widths: '600, 900, 1200, 1400', sizes: '(max-width: 900px) 100vw, 50vw' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'pgal__img placeholder' }}
    {%- endif -%}
  </div>
  {%- if product.images.size > 1 -%}
    <div class="pgal__thumbs">
      {%- for image in product.images -%}
        <button type="button" class="pgal__thumb{% if forloop.first %} is-active{% endif %}" data-thumb data-full="{{ image | image_url: width: 1400 }}" aria-label="View image {{ forloop.index }}">
          {{ image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'pgal__thumb-img', widths: '100, 200' }}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .pgal { display: flex; flex-direction: column; gap: 0.75rem; }
  .pgal__main { border-radius: var(--style-border-radius-cards, 12px); overflow: hidden; background: var(--color-surface); aspect-ratio: 4 / 5; }
  .pgal__img { width: 100%; height: 100%; object-fit: cover; }
  .pgal__thumbs { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .pgal__thumb { width: 64px; height: 64px; padding: 0; border: 1px solid var(--color-border); border-radius: var(--style-border-radius-inputs, 6px); overflow: hidden; cursor: pointer; background: var(--color-surface); }
  .pgal__thumb.is-active { border-color: var(--color-accent); }
  .pgal__thumb-img { width: 100%; height: 100%; object-fit: cover; }
{% endstylesheet %}
