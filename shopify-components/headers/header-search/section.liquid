<header class="hdr-s" data-sticky-header>
  <div class="page-width hdr-s__bar">
    <a class="hdr-s__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo -%}
        {{ section.settings.logo | image_url: width: 320 | image_tag: loading: 'eager', widths: '160, 240, 320', class: 'hdr-s__logo-img' }}
      {%- else -%}{{ shop.name }}{%- endif -%}
    </a>
    <form class="hdr-s__search" action="{{ routes.search_url }}" method="get" role="search">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input class="hdr-s__input" type="search" name="q" placeholder="{{ section.settings.placeholder | default: 'Search products…' }}" aria-label="Search">
    </form>
    <div class="hdr-s__icons">
      {%- if shop.customer_accounts_enabled -%}
        <a class="hdr-s__icon" href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        </a>
      {%- endif -%}
      <a class="hdr-s__icon hdr-s__cart" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 7h15l-1.6 10H7.6z"/><path d="M6 7 5 3H2"/><circle cx="9" cy="21" r="1.3"/><circle cx="18" cy="21" r="1.3"/></svg>
        {%- if cart.item_count > 0 -%}<span class="hdr-s__count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .hdr-s { position: sticky; top: 0; z-index: 50; background: var(--color-background); border-bottom: 1px solid var(--color-border); }
  .hdr-s.is-scrolled { box-shadow: 0 6px 24px -16px rgba(0,0,0,0.4); }
  .hdr-s__bar { display: flex; align-items: center; gap: 1.25rem; min-height: 4.5rem; }
  .hdr-s__logo { font-family: var(--font-heading--family, var(--font-primary--family)); font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em; text-decoration: none; color: var(--color-foreground); flex: none; }
  .hdr-s__logo-img { max-height: 2rem; width: auto; }
  .hdr-s__search { flex: 1; display: flex; align-items: center; gap: 0.5rem; max-width: 560px; margin-inline: auto; padding: 0.55rem 0.9rem; border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-surface); color: var(--color-foreground); }
  .hdr-s__input { flex: 1; border: none; background: transparent; color: inherit; outline: none; font: inherit; }
  .hdr-s__icons { display: flex; align-items: center; gap: 0.9rem; flex: none; }
  .hdr-s__icon { position: relative; color: var(--color-foreground); display: inline-flex; }
  .hdr-s__count { position: absolute; top: -7px; right: -8px; background: var(--color-accent); color: var(--color-on-accent); font-size: 0.65rem; font-weight: 700; min-width: 16px; height: 16px; display: grid; place-items: center; border-radius: 999px; padding: 0 4px; }
  @media (max-width: 749px) { .hdr-s__search { display: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Header — Search",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "placeholder", "label": "Search placeholder", "default": "Search products…" }
  ]
}
{% endschema %}
