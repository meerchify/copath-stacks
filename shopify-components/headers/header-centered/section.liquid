<header class="hdr-c" data-sticky-header>
  <div class="page-width hdr-c__top">
    <div class="hdr-c__side hdr-c__side--left">
      <a class="hdr-c__icon" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </a>
    </div>
    <a class="hdr-c__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo -%}
        {{ section.settings.logo | image_url: width: 360 | image_tag: loading: 'eager', widths: '180, 240, 360', class: 'hdr-c__logo-img' }}
      {%- else -%}{{ shop.name }}{%- endif -%}
    </a>
    <div class="hdr-c__side hdr-c__side--right">
      {%- if shop.customer_accounts_enabled -%}
        <a class="hdr-c__icon" href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        </a>
      {%- endif -%}
      <a class="hdr-c__icon hdr-c__cart" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 7h15l-1.6 10H7.6z"/><path d="M6 7 5 3H2"/><circle cx="9" cy="21" r="1.3"/><circle cx="18" cy="21" r="1.3"/></svg>
        {%- if cart.item_count > 0 -%}<span class="hdr-c__count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
  <nav class="hdr-c__nav page-width" aria-label="Primary">
    {%- for link in section.settings.menu.links -%}
      <a class="hdr-c__link" href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </nav>
</header>

{% stylesheet %}
  .hdr-c { position: sticky; top: 0; z-index: 50; background: var(--color-background); border-bottom: 1px solid var(--color-border); }
  .hdr-c.is-scrolled { box-shadow: 0 6px 24px -16px rgba(0,0,0,0.4); }
  .hdr-c__top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 4rem; }
  .hdr-c__side { display: flex; align-items: center; gap: 0.9rem; }
  .hdr-c__side--right { justify-content: flex-end; }
  .hdr-c__logo { justify-self: center; font-family: var(--font-heading--family, var(--font-primary--family)); font-weight: 700; font-size: 1.4rem; letter-spacing: -0.02em; text-decoration: none; color: var(--color-foreground); }
  .hdr-c__logo-img { max-height: 2.4rem; width: auto; }
  .hdr-c__icon { color: var(--color-foreground); display: inline-flex; position: relative; }
  .hdr-c__count { position: absolute; top: -7px; right: -8px; background: var(--color-accent); color: var(--color-on-accent); font-size: 0.65rem; font-weight: 700; min-width: 16px; height: 16px; display: grid; place-items: center; border-radius: 999px; padding: 0 4px; }
  .hdr-c__nav { display: flex; justify-content: center; gap: 1.8rem; padding-bottom: 0.75rem; }
  .hdr-c__link { text-decoration: none; color: var(--color-foreground); font-size: 0.9rem; opacity: 0.85; }
  .hdr-c__link:hover { opacity: 1; }
  @media (max-width: 800px) { .hdr-c__nav { display: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Header — Centered",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
