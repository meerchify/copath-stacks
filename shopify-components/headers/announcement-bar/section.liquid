<section class="announcement-bar" style="--ab-bg: {{ section.settings.background | default: 'var(--color-foreground)' }}; --ab-fg: {{ section.settings.text_color | default: 'var(--color-background)' }};">
  <div class="page-width announcement-bar__inner">
    {%- if section.settings.link != blank -%}<a class="announcement-bar__text" href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}<span class="announcement-bar__text">{{ section.settings.text }}</span>{%- endif -%}
  </div>
</section>

{% stylesheet %}
  .announcement-bar { background: var(--ab-bg); color: var(--ab-fg); }
  .announcement-bar__inner { display: flex; justify-content: center; padding-block: 0.55rem; }
  .announcement-bar__text { font-size: 0.82rem; letter-spacing: 0.04em; text-decoration: none; color: inherit; text-align: center; }
  .announcement-bar__text:hover { text-decoration: underline; }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "background", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text color" }
  ],
  "presets": [ { "name": "Announcement bar" } ]
}
{% endschema %}
