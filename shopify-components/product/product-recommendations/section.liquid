{%- liquid
  assign limit = section.settings.products_to_show
  assign fallback = collections[section.settings.fallback_collection]
  assign has_data = false
  if recommendations.performed and recommendations.products_count > 0
    assign has_data = true
  elsif fallback.products.size > 0
    assign has_data = true
  endif
-%}
<section class="section prec reveal">
  <div class="page-width">
    <header class="section__head">
      <div>
        {%- if section.settings.subheading != blank -%}<p class="eyebrow">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    </header>
    {%- unless has_data -%}
      {% render 'setup-note', message: 'Showing sample products. On a live product page Shopify fills this with real recommendations — or pick a fallback collection in this section.' %}
    {%- endunless -%}
    <div class="product-grid">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for product in recommendations.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- elsif fallback.products.size > 0 -%}
        {%- for product in fallback.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}{% render 'product-card' %}{%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "You may also like" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 },
    { "type": "collection", "id": "fallback_collection", "label": "Fallback collection", "info": "Shown when Shopify has no recommendations yet." }
  ],
  "presets": [ { "name": "Product recommendations" } ]
}
{% endschema %}
