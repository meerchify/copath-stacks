{% comment %}
  Product main — Gallery layout: all images stacked on the left, a sticky buy
  column on the right. Reuses the shared product-buy-form snippet.
{% endcomment %}
<section class="pdp pdp-gal section" data-pdp>
  <div class="page-width pdp-gal__grid">
    <div class="pdp-gal__media">
      {%- for image in product.images -%}
        {%- assign pg_loading = 'lazy' -%}{%- if forloop.first -%}{%- assign pg_loading = 'eager' -%}{%- endif -%}
        {{ image | image_url: width: 1400 | image_tag: loading: pg_loading, class: 'pdp-gal__img', widths: '600, 900, 1200, 1400', sizes: '(max-width: 900px) 100vw, 55vw' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'pdp-gal__img placeholder' }}
      {%- endfor -%}
    </div>
    <div class="pdp-gal__info">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="pdp__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h1 class="pdp__title">{{ product.title }}</h1>
      {% render 'product-buy-form' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-gal__grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(24px, 5vw, 72px); align-items: start; padding-block: clamp(24px, 4vw, 56px); }
  .pdp-gal__media { display: flex; flex-direction: column; gap: clamp(8px, 1.5vw, 16px); }
  .pdp-gal__img { width: 100%; border-radius: var(--style-border-radius-cards, 12px); background: var(--color-surface); object-fit: cover; }
  .pdp-gal__info { position: sticky; top: 6rem; }
  .pdp__vendor { text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.78rem; opacity: 0.6; margin-bottom: 0.4rem; }
  .pdp__title { font-family: var(--font-heading--family, var(--font-primary--family)); font-size: clamp(1.8rem, 3.5vw, 2.75rem); line-height: 1.08; letter-spacing: -0.02em; }
  @media (max-width: 850px) { .pdp-gal__grid { grid-template-columns: 1fr; } .pdp-gal__info { position: static; } }
{% endstylesheet %}

{% javascript %}
  (function () {
    document.querySelectorAll('[data-pdp]').forEach(function (root) {
      var script = root.querySelector('[data-variants]');
      if (!script) return;
      var variants;
      try { variants = JSON.parse(script.textContent); } catch (e) { return; }
      var selects = root.querySelectorAll('[data-option]');
      if (!selects.length) return;
      var idInput = root.querySelector('[data-variant-id]');
      var priceEl = root.querySelector('[data-price]');
      var compareEl = root.querySelector('[data-compare]');
      var atc = root.querySelector('[data-atc]');
      var atcText = root.querySelector('[data-atc-text]');
      function update() {
        var chosen = Array.prototype.map.call(selects, function (s) { return s.value; });
        var v = variants.find(function (x) {
          return x.options.length === chosen.length && x.options.every(function (o, i) { return o === chosen[i]; });
        });
        if (!v) { if (atc) atc.disabled = true; if (atcText) atcText.textContent = 'Unavailable'; return; }
        if (idInput) idInput.value = v.id;
        if (priceEl) priceEl.textContent = v.price;
        if (compareEl) { if (v.onSale) { compareEl.textContent = v.compareAt; compareEl.hidden = false; } else { compareEl.hidden = true; } }
        if (atc) atc.disabled = !v.available;
        if (atcText) atcText.textContent = v.available ? 'Add to cart' : 'Sold out';
      }
      selects.forEach(function (s) { s.addEventListener('change', update); });
      update();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Product — Gallery",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
