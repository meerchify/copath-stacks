{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}
<section class="section pcsl reveal">
  <div class="page-width">
    <header class="section__head">
      <div>
        {%- if section.settings.subheading != blank -%}<p class="eyebrow">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <div class="pcsl__nav">
        <button class="pcsl__btn" data-prev aria-label="Previous">&#8249;</button>
        <button class="pcsl__btn" data-next aria-label="Next">&#8250;</button>
      </div>
    </header>
    <div class="pcsl__track" data-scroller>
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <div class="pcsl__item">{% render 'product-card', product: product %}</div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="pcsl__item">{% render 'product-card' %}</div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pcsl__nav { display: flex; gap: 0.5rem; }
  .pcsl__btn { width: 40px; height: 40px; border-radius: 999px; border: 1px solid var(--color-border); background: var(--color-background); color: var(--color-foreground); font-size: 1.3rem; line-height: 1; cursor: pointer; display: grid; place-items: center; }
  .pcsl__btn:hover { background: var(--color-surface); }
  .pcsl__track { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(200px, 24vw, 280px); gap: clamp(12px, 2vw, 24px); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px; }
  .pcsl__track::-webkit-scrollbar { display: none; }
  .pcsl__item { scroll-snap-align: start; }
{% endstylesheet %}

{% javascript %}
  (function () {
    document.querySelectorAll('.pcsl').forEach(function (root) {
      var sc = root.querySelector('[data-scroller]');
      if (!sc) return;
      function step() { return Math.max(sc.clientWidth * 0.8, 240); }
      var p = root.querySelector('[data-prev]'), n = root.querySelector('[data-next]');
      if (p) p.addEventListener('click', function () { sc.scrollBy({ left: -step(), behavior: 'smooth' }); });
      if (n) n.addEventListener('click', function () { sc.scrollBy({ left: step(), behavior: 'smooth' }); });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Product carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Trending" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On everyone's list" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "label": "Products", "default": 10 }
  ],
  "presets": [ { "name": "Product carousel" } ]
}
{% endschema %}
