{%- liquid
  assign img = section.settings.image
-%}
<section class="hero reveal" style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  {%- if img -%}
    <div class="hero__media">
      {{ img | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero__img', widths: '800, 1200, 1600, 2400', sizes: '100vw' }}
    </div>
  {%- endif -%}
  <div class="page-width hero__inner hero__inner--{{ section.settings.text_align }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--primary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a class="btn btn--ghost" href="{{ section.settings.button_link_2 | default: '#' }}">{{ section.settings.button_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(420px, 70vh, 760px);
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-foreground);
  }
  .hero__media { position: absolute; inset: 0; }
  .hero__img { width: 100%; height: 100%; object-fit: cover; }
  .hero:has(.hero__media)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,calc(var(--hero-overlay) * 0.4)), rgba(0,0,0,var(--hero-overlay)));
  }
  .hero:has(.hero__media) { color: #fff; }
  .hero__inner { position: relative; z-index: 1; max-width: 760px; padding-block: 48px; }
  .hero__inner--center { margin-inline: auto; text-align: center; }
  .hero__inner--center .hero__actions { justify-content: center; }
  .hero__title {
    font-family: var(--font-heading--family, var(--font-primary--family));
    font-weight: var(--font-heading--weight, 700);
    font-size: clamp(2.4rem, 6vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .hero__subheading { font-size: clamp(1rem, 1.6vw, 1.25rem); max-width: 52ch; opacity: 0.92; }
  .hero__inner--center .hero__subheading { margin-inline: auto; }
  .hero__actions { display: flex; gap: 0.75rem; margin-top: 1.75rem; flex-wrap: wrap; }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the way you live" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Premium products, fair prices, fast shipping." },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image overlay", "default": 35 },
    {
      "type": "select", "id": "text_align", "label": "Text alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "Explore" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
