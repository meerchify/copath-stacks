<section class="hero-banner reveal" style="--hb-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  {%- if section.settings.image -%}
    <div class="hero-banner__media">
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'hero-banner__img', widths: '1000, 1600, 2400', sizes: '100vw' }}
    </div>
  {%- endif -%}
  <div class="page-width hero-banner__inner">
    <div class="hero-banner__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow hero-banner__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hero-banner__title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--primary hero-banner__cta" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hero-banner { position: relative; overflow: hidden; background: var(--color-surface); }
  .hero-banner:has(.hero-banner__media) { color: #fff; }
  .hero-banner__media { position: absolute; inset: 0; }
  .hero-banner__img { width: 100%; height: 100%; object-fit: cover; }
  .hero-banner:has(.hero-banner__media)::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,var(--hb-overlay)); }
  .hero-banner__inner { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: clamp(36px, 5vw, 72px); flex-wrap: wrap; }
  .hero-banner__title { font-family: var(--font-heading--family, var(--font-primary--family)); font-size: clamp(1.6rem, 3.5vw, 3rem); line-height: 1.05; letter-spacing: -0.02em; }
  .hero-banner__cta { flex: none; }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited time" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Up to 40% off the summer edit" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay", "default": 35 },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop the sale" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Hero — Banner" } ]
}
{% endschema %}
