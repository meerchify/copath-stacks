<section class="cta-banner reveal{% if section.settings.image %} cta-banner--image{% endif %}" style="--cta-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  {%- if section.settings.image -%}
    <div class="cta-banner__media">
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', class: 'cta-banner__img', widths: '1000, 1600, 2400', sizes: '100vw' }}
    </div>
  {%- endif -%}
  <div class="page-width cta-banner__inner">
    {%- if section.settings.heading != blank -%}<h2 class="cta-banner__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="cta-banner__text">{{ section.settings.text }}</p>{%- endif -%}
    <div class="cta-banner__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--primary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cta-banner { position: relative; overflow: hidden; background: var(--color-surface); }
  .cta-banner--image { color: #fff; }
  .cta-banner__media { position: absolute; inset: 0; }
  .cta-banner__img { width: 100%; height: 100%; object-fit: cover; }
  .cta-banner--image::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,var(--cta-overlay)); }
  .cta-banner__inner { position: relative; z-index: 1; max-width: 640px; margin-inline: auto; text-align: center; padding-block: clamp(56px, 9vw, 140px); }
  .cta-banner__title { font-family: var(--font-heading--family, var(--font-primary--family)); font-size: clamp(2rem, 4.5vw, 3.5rem); line-height: 1.05; letter-spacing: -0.02em; }
  .cta-banner__text { opacity: 0.85; margin-top: 0.75rem; font-size: clamp(1rem, 1.4vw, 1.2rem); }
  .cta-banner__actions { display: flex; gap: 0.75rem; justify-content: center; margin-top: 1.75rem; flex-wrap: wrap; }
{% endstylesheet %}

{% schema %}
{
  "name": "CTA banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready when you are" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join thousands of happy customers today." },
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay", "default": 45 },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "CTA banner" } ]
}
{% endschema %}
