<section class="section steps reveal">
  <div class="page-width">
    <header class="section__head steps__head">
      <div>
        {%- if section.settings.subheading != blank -%}<p class="eyebrow">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    </header>
    <ol class="steps__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <span class="step__num">{{ forloop.index }}</span>
          <h3 class="step__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="step__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .steps__head { justify-content: center; text-align: center; }
  .steps__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: clamp(20px, 3vw, 44px); counter-reset: step; }
  .step { display: flex; flex-direction: column; gap: 0.6rem; }
  .step__num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 999px; border: 1px solid var(--color-border); color: var(--color-accent); font-weight: 700; }
  .step__title { font-size: 1.1rem; font-weight: 600; }
  .step__text { opacity: 0.72; font-size: 0.95rem; line-height: 1.5; }
{% endstylesheet %}

{% schema %}
{
  "name": "Steps",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three simple steps" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Choose your product" },
        { "type": "text", "id": "text", "label": "Text", "default": "Browse the collection and pick your favourite." }
      ]
    }
  ],
  "presets": [
    { "name": "Steps", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] }
  ]
}
{% endschema %}
