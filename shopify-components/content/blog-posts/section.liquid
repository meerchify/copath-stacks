{%- liquid
  assign blog = blogs[section.settings.blog]
  assign limit = section.settings.posts_to_show
-%}
<section class="section blog-posts reveal">
  <div class="page-width">
    <header class="section__head">
      <div>
        {%- if section.settings.subheading != blank -%}<p class="eyebrow">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    </header>
    {%- unless blog.articles.size > 0 -%}
      {% render 'setup-note', message: 'Showing sample posts. Create a blog in Shopify (Online Store → Blog posts) and select it in this section.' %}
    {%- endunless -%}
    <div class="blog-posts__grid">
      {%- if blog.articles.size > 0 -%}
        {%- for article in blog.articles limit: limit -%}
          <a class="post-card" href="{{ article.url }}">
            <div class="post-card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'post-card__img', widths: '300, 500, 800', sizes: '(max-width: 700px) 100vw, 33vw' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'post-card__img placeholder' }}
              {%- endif -%}
            </div>
            <h3 class="post-card__title">{{ article.title }}</h3>
            <p class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="post-card post-card--placeholder">
            <div class="post-card__media">{{ 'lifestyle-1' | placeholder_svg_tag: 'post-card__img' }}</div>
            <h3 class="post-card__title">Blog post title</h3>
            <p class="post-card__excerpt">A short preview of the article will appear here once you connect a blog.</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .blog-posts__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2.5vw, 32px); }
  .post-card { display: block; color: inherit; text-decoration: none; }
  .post-card__media { border-radius: var(--style-border-radius-cards, 12px); overflow: hidden; aspect-ratio: 3 / 2; background: var(--color-surface); margin-bottom: 0.85rem; }
  .post-card__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease-spring); }
  .post-card:hover .post-card__img { transform: scale(1.04); }
  .post-card__title { font-size: 1.1rem; font-weight: 600; line-height: 1.2; }
  .post-card__excerpt { opacity: 0.7; font-size: 0.9rem; line-height: 1.5; margin-top: 0.4rem; }
  @media (max-width: 800px) { .blog-posts__grid { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the blog" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 6, "step": 1, "label": "Posts", "default": 3 }
  ],
  "presets": [ { "name": "Blog posts" } ]
}
{% endschema %}
