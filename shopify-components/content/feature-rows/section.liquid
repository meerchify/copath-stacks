<section class="section feature-rows reveal">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="section__head feature-rows__head"><h2 class="section__title">{{ section.settings.heading }}</h2></header>
    {%- endif -%}
    <div class="feature-rows__list">
      {%- for block in section.blocks -%}
        <div class="feature-row" {{ block.shopify_attributes }}>
          <div class="feature-row__media">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'feature-row__img', widths: '400, 700, 1000', sizes: '(max-width: 800px) 100vw, 45vw' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'feature-row__img placeholder' }}
            {%- endif -%}
          </div>
          <div class="feature-row__text">
            {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h3 class="feature-row__title">{{ block.settings.heading }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="feature-row__body rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="btn btn--ghost feature-row__cta" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .feature-rows__list { display: flex; flex-direction: column; gap: clamp(32px, 6vw, 88px); }
  .feature-row { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(24px, 5vw, 64px); }
  .feature-row:nth-child(even) .feature-row__media { order: 2; }
  .feature-row__media { border-radius: var(--style-border-radius-cards, 12px); overflow: hidden; aspect-ratio: 4 / 3; background: var(--color-surface); }
  .feature-row__img { width: 100%; height: 100%; object-fit: cover; }
  .feature-row__title { font-family: var(--font-heading--family, var(--font-primary--family)); font-size: clamp(1.5rem, 3vw, 2.5rem); line-height: 1.08; letter-spacing: -0.02em; margin-bottom: 0.75rem; }
  .feature-row__body { opacity: 0.82; line-height: 1.6; max-width: 50ch; }
  .feature-row__cta { margin-top: 1.25rem; }
  @media (max-width: 800px) { .feature-row { grid-template-columns: 1fr; } .feature-row:nth-child(even) .feature-row__media { order: 0; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature rows",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A feature worth showing" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Explain a benefit, material or process in a sentence or two.</p>" },
        { "type": "text", "id": "button_label", "label": "Button" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    { "name": "Feature rows", "blocks": [ { "type": "row" }, { "type": "row" } ] }
  ]
}
{% endschema %}
