<section class="section testimonials reveal">
  <div class="page-width">
    <header class="section__head testimonials__head">
      <div>
        {%- if section.settings.subheading != blank -%}<p class="eyebrow">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    </header>
    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          {%- if block.settings.rating != blank -%}
            <div class="testimonial__stars" aria-label="{{ block.settings.rating }} out of 5">
              {%- assign r = block.settings.rating | times: 1 -%}
              {%- for i in (1..5) -%}<span aria-hidden="true">{% if i <= r %}&#9733;{% else %}&#9734;{% endif %}</span>{%- endfor -%}
            </div>
          {%- endif -%}
          <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
          <figcaption class="testimonial__author">{{ block.settings.author }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .testimonials__head { justify-content: center; text-align: center; }
  .testimonials__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2.5vw, 28px); }
  .testimonial {
    margin: 0; padding: clamp(20px, 2.5vw, 32px);
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-cards, 12px);
    display: flex; flex-direction: column; gap: 0.85rem;
  }
  .testimonial__stars { color: var(--color-accent); letter-spacing: 0.1em; }
  .testimonial__quote { font-size: 1.05rem; line-height: 1.55; }
  .testimonial__author { font-size: 0.9rem; opacity: 0.65; font-weight: 600; }
  @media (max-width: 990px) { .testimonials__grid { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Loved by customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people are saying" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Genuinely the best purchase I've made all year." },
        { "type": "text", "id": "author", "label": "Author", "default": "Alex M." },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [ { "type": "quote" }, { "type": "quote" }, { "type": "quote" } ]
    }
  ]
}
{% endschema %}
