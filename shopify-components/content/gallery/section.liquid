<section class="section gallery reveal">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="section__head gallery__head"><h2 class="section__title">{{ section.settings.heading }}</h2></header>
    {%- endif -%}
    <div class="gallery__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a class="gallery__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{%- else -%}<div class="gallery__item" {{ block.shopify_attributes }}>{%- endif -%}
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'gallery__img', widths: '300, 500, 800, 1000', sizes: '(max-width: 600px) 50vw, 25vw' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'gallery__img placeholder' }}
          {%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .gallery__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(8px, 1.5vw, 16px); }
  .gallery__item { display: block; overflow: hidden; border-radius: var(--style-border-radius-cards, 12px); background: var(--color-surface); aspect-ratio: 1; }
  .gallery__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease-spring); }
  .gallery__item:hover .gallery__img { transform: scale(1.05); }
  @media (max-width: 800px) { .gallery__grid { grid-template-columns: repeat(2, 1fr); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the gram" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Gallery", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" } ] }
  ]
}
{% endschema %}
