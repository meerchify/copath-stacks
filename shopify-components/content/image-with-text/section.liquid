<section class="section iwt reveal iwt--{{ section.settings.media_side }}">
  <div class="page-width iwt__grid">
    <div class="iwt__media">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'iwt__img', widths: '500, 800, 1100, 1200', sizes: '(max-width: 800px) 100vw, 50vw' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'iwt__img placeholder' }}
      {%- endif -%}
    </div>
    <div class="iwt__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="iwt__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="iwt__body rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--primary iwt__cta" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .iwt__grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(24px, 5vw, 72px); }
  .iwt--right .iwt__media { order: 2; }
  .iwt__media { border-radius: var(--style-border-radius-cards, 12px); overflow: hidden; aspect-ratio: 4 / 3; background: var(--color-surface); }
  .iwt__img { width: 100%; height: 100%; object-fit: cover; }
  .iwt__title { font-family: var(--font-heading--family, var(--font-primary--family)); font-size: clamp(1.7rem, 3.5vw, 3rem); line-height: 1.06; letter-spacing: -0.02em; margin-bottom: 1rem; }
  .iwt__body { opacity: 0.82; line-height: 1.6; max-width: 52ch; }
  .iwt__cta { margin-top: 1.5rem; }
  @media (max-width: 800px) { .iwt__grid { grid-template-columns: 1fr; } .iwt--right .iwt__media { order: 0; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "media_side", "label": "Image side", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our craft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built with intention" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe a feature, your story, or a promise to your customers.</p>" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
