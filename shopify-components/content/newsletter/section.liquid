<section class="section newsletter reveal" style="--nl-bg: {{ section.settings.background | default: 'var(--color-surface)' }};">
  <div class="page-width newsletter__inner">
    {%- if section.settings.heading != blank -%}<h2 class="newsletter__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="newsletter__text">{{ section.settings.text }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="nl-email">Email</label>
      <input
        id="nl-email"
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
        required
        autocomplete="email"
        class="newsletter__input"
      >
      <button type="submit" class="btn btn--primary">{{ section.settings.button_label | default: 'Subscribe' }}</button>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__msg newsletter__msg--ok">Thanks for subscribing!</p>
      {%- elsif form.errors -%}
        <p class="newsletter__msg newsletter__msg--err">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .newsletter { background: var(--nl-bg); }
  .newsletter__inner { max-width: 640px; margin-inline: auto; text-align: center; }
  .newsletter__title { font-family: var(--font-heading--family, var(--font-primary--family)); font-size: clamp(1.6rem, 3.5vw, 2.5rem); line-height: 1.1; letter-spacing: -0.02em; }
  .newsletter__text { opacity: 0.8; margin-top: 0.6rem; }
  .newsletter__form { display: flex; gap: 0.6rem; margin-top: 1.4rem; flex-wrap: wrap; justify-content: center; }
  .newsletter__input { flex: 1 1 240px; padding: 0.85rem 1rem; border: 1px solid var(--color-border); border-radius: var(--style-border-radius-cards, 12px); background: var(--color-background); color: var(--color-foreground); }
  .newsletter__msg { flex-basis: 100%; margin-top: 0.5rem; font-size: 0.9rem; }
  .newsletter__msg--ok { color: var(--color-accent); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
    { "type": "text", "id": "text", "label": "Text", "default": "New drops, restocks and members-only deals." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "color", "id": "background", "label": "Background" }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
