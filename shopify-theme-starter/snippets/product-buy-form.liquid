{% comment %}
  Product buy form — price, variant option selects, quantity, add-to-cart + payment
  button, and a JSON variant map for client-side switching. Shared by all
  product-main sections so the commerce logic lives in ONE vetted place.
  Usage: {% render 'product-buy-form' %}  (relies on the global `product`).
{% endcomment %}
{%- assign cv = product.selected_or_first_available_variant -%}
<div class="pbf">
  <div class="pbf__price">
    <span class="pbf__price-now" data-price>{{ cv.price | money }}</span>
    {%- if cv.compare_at_price > cv.price -%}
      <s class="pbf__price-was" data-compare>{{ cv.compare_at_price | money }}</s>
    {%- else -%}
      <s class="pbf__price-was" data-compare hidden></s>
    {%- endif -%}
  </div>

  {%- if product.description != blank -%}
    <div class="pbf__desc rte">{{ product.description }}</div>
  {%- endif -%}

  {%- form 'product', product, class: 'pbf__form' -%}
    {%- unless product.has_only_default_variant -%}
      <div class="pbf__options">
        {%- for option in product.options_with_values -%}
          <label class="pbf__option">
            <span class="pbf__option-name">{{ option.name }}</span>
            <select class="pbf__select" data-option="{{ forloop.index0 }}">
              {%- for value in option.values -%}
                <option value="{{ value }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endfor -%}
      </div>
    {%- endunless -%}

    <input type="hidden" name="id" value="{{ cv.id }}" data-variant-id>

    <div class="pbf__buy">
      <input class="pbf__qty" type="number" name="quantity" min="1" value="1" aria-label="Quantity">
      <button type="submit" name="add" class="btn btn--primary pbf__atc" data-atc{% unless cv.available %} disabled{% endunless %}>
        <span data-atc-text>{% if cv.available %}Add to cart{% else %}Sold out{% endif %}</span>
      </button>
    </div>
    {{ form | payment_button }}
  {%- endform -%}

  <script type="application/json" data-variants>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available }},"price":{{ v.price | money | json }},"compareAt":{{ v.compare_at_price | money | json }},"onSale":{% if v.compare_at_price > v.price %}true{% else %}false{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  </script>
</div>

{% stylesheet %}
  .pbf__price { display: flex; align-items: baseline; gap: 0.6rem; margin: 0.5rem 0 1rem; }
  .pbf__price-now { font-size: 1.5rem; font-weight: 700; }
  .pbf__price-was { opacity: 0.5; font-weight: 400; }
  .pbf__price-was[hidden] { display: none; }
  .pbf__desc { opacity: 0.82; line-height: 1.6; margin-bottom: 1.5rem; max-width: 56ch; }
  .pbf__options { display: flex; flex-direction: column; gap: 0.9rem; margin-bottom: 1.25rem; }
  .pbf__option { display: flex; flex-direction: column; gap: 0.35rem; }
  .pbf__option-name { font-size: 0.85rem; font-weight: 600; opacity: 0.8; }
  .pbf__select { padding: 0.7rem 0.9rem; border: 1px solid var(--color-border); border-radius: var(--style-border-radius-inputs, 6px); background: var(--color-background); color: var(--color-foreground); max-width: 320px; }
  .pbf__buy { display: flex; gap: 0.6rem; align-items: stretch; margin-bottom: 0.75rem; }
  .pbf__qty { width: 78px; padding: 0.7rem 0.6rem; text-align: center; border: 1px solid var(--color-border); border-radius: var(--style-border-radius-inputs, 6px); background: var(--color-background); color: var(--color-foreground); }
  .pbf__atc { flex: 1; }
  .pbf__atc[disabled] { opacity: 0.5; cursor: not-allowed; }
{% endstylesheet %}
