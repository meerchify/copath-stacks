<div class="page-width cart">
  <h1>{{ 'cart.general.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart -%}
      <ul class="cart__items" style="list-style:none;padding:0">
        {%- for item in cart.items -%}
          <li style="display:flex;gap:1rem;padding:1rem 0;border-bottom:1px solid #eee">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" width="120">
            {%- endif -%}
            <div>
              <a href="{{ item.url }}">{{ item.product.title }}</a>
              <p>{{ item.final_line_price | money }}</p>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity' | t }}">
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <p class="cart__subtotal">{{ 'cart.general.subtotal' | t }}: {{ cart.total_price | money }}</p>
      <button type="submit" name="checkout">{{ 'cart.general.checkout' | t }}</button>
    {%- endform -%}
  {%- else -%}
    <p>{{ 'cart.general.empty' | t }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
