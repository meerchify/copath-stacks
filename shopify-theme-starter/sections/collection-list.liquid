<section class="section collection-list reveal">
  <div class="page-width">
    <header class="section__head">
      <div>
        {%- if section.settings.subheading != blank -%}<p class="eyebrow">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    </header>

    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- assign c = collections[block.settings.collection] -%}
        <a class="category-tile" href="{% if c %}{{ c.url }}{% else %}{{ block.settings.link | default: '#' }}{% endif %}" {{ block.shopify_attributes }}>
          <div class="category-tile__media">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 500, 700, 900', sizes: '(max-width: 600px) 100vw, 33vw' }}
            {%- elsif c.featured_image -%}
              {{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 500, 700, 900', sizes: '(max-width: 600px) 100vw, 33vw' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <span class="category-tile__label">
            {{ block.settings.title | default: c.title | default: 'Category' }}
            <span class="category-tile__arrow" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .category-tile { position: relative; display: block; color: #fff; text-decoration: none; border-radius: var(--style-border-radius-cards, 12px); overflow: hidden; aspect-ratio: 3 / 4; background: var(--color-surface); }
  .category-tile__media { position: absolute; inset: 0; }
  .category-tile__media img, .category-tile__media svg { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-spring); }
  .category-tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,0.6)); }
  .category-tile:hover .category-tile__media img, .category-tile:hover .category-tile__media svg { transform: scale(1.05); }
  .category-tile__label { position: absolute; left: 1rem; bottom: 1rem; z-index: 1; font-weight: 600; font-size: 1.1rem; display: inline-flex; align-items: center; gap: 0.4rem; }
  .category-tile__arrow { transition: transform 0.2s var(--ease-spring); }
  .category-tile:hover .category-tile__arrow { transform: translateX(4px); }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link (if no collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "category", "settings": { "title": "New arrivals" } },
        { "type": "category", "settings": { "title": "Best sellers" } },
        { "type": "category", "settings": { "title": "On sale" } }
      ]
    }
  ]
}
{% endschema %}
