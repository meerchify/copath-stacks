<div class="page-width collection">
  <h1>{{ collection.title }}</h1>
  <div class="collection__grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.5rem">
    {%- for product in collection.products -%}
      <a href="{{ product.url }}" class="card">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.featured_image.alt | escape }}" width="400">
        {%- endif -%}
        <h3>{{ product.title }}</h3>
        <p>{{ product.price | money }}</p>
      </a>
    {%- else -%}
      <p>No products found.</p>
    {%- endfor -%}
  </div>
  {{ paginate | default_pagination }}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
