<div class="page-width product">
  {%- if product.featured_image -%}
    <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" width="800">
  {%- endif -%}
  <h1>{{ product.title }}</h1>
  <p class="product__price">{{ product.price | money }}</p>
  <div class="product__description rte">{{ product.description }}</div>

  {%- form 'product', product -%}
    <select name="id">
      {%- for variant in product.variants -%}
        <option value="{{ variant.id }}" {% if variant.available == false %}disabled{% endif %}>
          {{ variant.title }} — {{ variant.price | money }}
        </option>
      {%- endfor -%}
    </select>
    <button type="submit" name="add" {% unless product.available %}disabled{% endunless %}>
      {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
    </button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
